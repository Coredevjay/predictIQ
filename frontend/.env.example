# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# API Configuration
# The URL of the backend API server
# Required: Yes
# Example: http://localhost:3001 or https://api.predictiq.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# TTS Configuration
# The URL of the services/tts text-to-speech service
# Required: No — TTS features are disabled when unset
# Example: http://localhost:3002
NEXT_PUBLIC_TTS_API_URL=http://localhost:3002

# Horizon Configuration
# Optional override for the Horizon base URL used by the wallet balance module.
# When unset or empty, the built-in PUBLIC/TESTNET/FUTURENET endpoints are used.
# Example: https://horizon.my-org.internal
NEXT_PUBLIC_HORIZON_URL_OVERRIDE=

# Soroban contract configuration (optional)
# Required for on-chain write flows (filing a dispute, claiming winnings).
# When either is unset, those pages render a "not configured" message instead
# of submitting to a nonexistent backend route.
# Example: CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
NEXT_PUBLIC_CONTRACT_ID=
# Soroban RPC endpoint for the network the contract is deployed to.
# Example: https://soroban-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=
# Network passphrase the wallet should sign for. Defaults to the Stellar
# testnet passphrase when unset.
# Example: "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=
